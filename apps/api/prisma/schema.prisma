generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProductCategory {
  smartphones
  laptops
  headphones
}

enum AvailabilityStatus {
  in_stock
  limited
  out_of_stock
  unknown
}

enum NotificationType {
  price_drop
  alert_triggered
  system
}

enum PriceHistorySource {
  seed
  manual
  adapter
}

enum IntegrationProviderKey {
  amazon_in_creators
  flipkart_affiliate
}

enum IntegrationFailureStage {
  auth
  search
  details
  price
  availability
  match
  normalize
  validate
  persist
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  watchlist    Watchlist[]
  priceAlerts  PriceAlert[]
  notifications Notification[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenHash String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  brand       String
  category    ProductCategory
  description String
  image       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@index([category])
  @@index([brand])
  @@index([name])
}

model ProductVariant {
  id          String            @id @default(cuid())
  productId   String
  sku         String            @unique
  modelNumber String?
  /// JSON object of display attributes (storage, color, etc.)
  attributes  Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  listings    RetailerListing[]
  watchlist   Watchlist[]
  matches     ProductMatch[]

  @@index([productId])
}

model Retailer {
  id        String            @id @default(cuid())
  name      String            @unique
  website   String
  logo      String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  listings  RetailerListing[]
}

model RetailerListing {
  id                String                  @id @default(cuid())
  productVariantId  String
  retailerId        String
  externalProductId String?
  productUrl        String?
  currentPrice      Decimal                 @db.Decimal(12, 2)
  currency          String                  @default("INR")
  availability      AvailabilityStatus      @default(unknown)
  lastVerifiedAt    DateTime
  /// When true, price must not be presented as current in API responses.
  isStale           Boolean                 @default(false)
  providerKey       IntegrationProviderKey?
  dealLabel         String?
  /// Original retailer payload fragment when licensing permits retention.
  rawPayload        Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  productVariant    ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  retailer          Retailer                @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  priceHistory      PriceHistory[]
  priceAlerts       PriceAlert[]

  @@unique([productVariantId, retailerId])
  @@index([retailerId])
  @@index([currentPrice])
  @@index([lastVerifiedAt])
  @@index([isStale])
  @@index([providerKey])
}

/// Candidate or accepted mapping between a catalog variant and a retailer SKU/ASIN.
model ProductMatch {
  id                 String                 @id @default(cuid())
  productVariantId   String
  providerKey        IntegrationProviderKey
  externalProductId  String
  confidence         Decimal                @db.Decimal(5, 4)
  /// Accepted matches may drive price ingestion; low-confidence stays pending review.
  status             String                 @default("pending")
  matchedOn          Json
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  productVariant     ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, providerKey, externalProductId])
  @@index([providerKey, status])
  @@index([confidence])
}

model IntegrationFailure {
  id          String                   @id @default(cuid())
  providerKey IntegrationProviderKey
  stage       IntegrationFailureStage
  message     String
  details     Json?
  externalId  String?
  createdAt   DateTime                 @default(now())

  @@index([providerKey, createdAt])
  @@index([stage])
}

model PriceHistory {
  id                String             @id @default(cuid())
  retailerListingId String
  price             Decimal            @db.Decimal(12, 2)
  currency          String             @default("INR")
  recordedAt        DateTime           @default(now())
  source            PriceHistorySource @default(manual)
  retailerListing   RetailerListing    @relation(fields: [retailerListingId], references: [id], onDelete: Cascade)

  @@index([retailerListingId, recordedAt])
  @@index([recordedAt])
}

model Watchlist {
  id               String         @id @default(cuid())
  userId           String
  productVariantId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
  @@index([userId])
}

model PriceAlert {
  id                String          @id @default(cuid())
  userId            String
  retailerListingId String
  targetPrice       Decimal         @db.Decimal(12, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailerListing   RetailerListing @relation(fields: [retailerListingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([retailerListingId])
  @@index([isActive])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([readAt])
}

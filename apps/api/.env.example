NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

DATABASE_URL=postgresql://akash-sharma@localhost:5432/price_hunter?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Seed demo catalog (labelled demonstration data — not live retailer prices)
SEED_DEMO_DATA=true

# --- Phase 3 retailer integrations (authorized APIs only; no scraping) ---
PRICE_STALE_AFTER_HOURS=24
PRICE_SUSPICIOUS_CHANGE_PERCENT=40

# Amazon India Creators API
# Requires Associates acceptance + Creators API credentials. See docs/RETAILER_API_RESEARCH.md
AMAZON_CREATORS_ENABLED=false
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in

# Flipkart Affiliate API
# Requires affiliate account + API token. See docs/RETAILER_API_RESEARCH.md
FLIPKART_AFFILIATE_ENABLED=false
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
